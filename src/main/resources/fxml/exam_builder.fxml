<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.ExamBuilderController" styleClass="dashboard-shell"><top><HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar"><padding><Insets top="16" right="26" bottom="16" left="26"/></padding><Button text="← Dashboard" onAction="#back" styleClass="outline-button"/><Label text="Create normal examination" styleClass="page-title"/></HBox></top><center><HBox spacing="20" styleClass="dashboard-content"><padding><Insets top="22" right="26" bottom="22" left="26"/></padding><VBox spacing="10" prefWidth="350" styleClass="content-card"><Label text="Examination details" styleClass="section-title"/><Label text="Subject"/><ChoiceBox fx:id="subjectChoice" onAction="#loadQuestions"/><Label text="Title"/><TextField fx:id="titleField"/><Label text="Description"/><TextArea fx:id="descriptionArea" prefRowCount="4"/><Label text="Duration (minutes)"/><TextField fx:id="durationField" promptText="e.g. 30"/><Button text="Publish normal examination" onAction="#create" styleClass="primary-button"/><Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/></VBox><VBox spacing="10" styleClass="content-card" HBox.hgrow="ALWAYS"><Label text="Select fixed questions" styleClass="section-title"/><Label text="Use Ctrl/Cmd to select more than one question." styleClass="muted-text"/><ListView fx:id="questionList" VBox.vgrow="ALWAYS" onMouseClicked="#updateTotal"/><Label fx:id="totalLabel" text="Total marks: 0" styleClass="metric-label"/></VBox></HBox></center></BorderPane>
