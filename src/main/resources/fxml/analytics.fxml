<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.AnalyticsController" styleClass="dashboard-shell"><top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar"><padding><Insets top="16" right="26" bottom="16" left="26"/></padding><Button text="← Dashboard" onAction="#back" styleClass="outline-button"/><Label text="Performance analytics" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="outline-button"/></HBox></top><center><ScrollPane fitToWidth="true" styleClass="plain-scroll"><VBox spacing="18" styleClass="dashboard-content"><padding><Insets top="20" right="26" bottom="26" left="26"/></padding><HBox spacing="12"><VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="TESTS" styleClass="metric-label"/><Label fx:id="testsLabel" styleClass="metric-value"/></VBox><VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="AVERAGE" styleClass="metric-label"/><Label fx:id="averageLabel" styleClass="metric-value"/></VBox><VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="HIGHEST" styleClass="metric-label"/><Label fx:id="highestLabel" styleClass="metric-value"/></VBox><VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="LOWEST" styleClass="metric-label"/><Label fx:id="lowestLabel" styleClass="metric-value"/></VBox><VBox styleClass="metric-card" HBox.hgrow="ALWAYS"><Label text="ACCURACY" styleClass="metric-label"/><Label fx:id="accuracyLabel" styleClass="metric-value"/></VBox></HBox><HBox spacing="18"><BarChart fx:id="topicChart" prefHeight="300" HBox.hgrow="ALWAYS"><xAxis><CategoryAxis label="Topic"/></xAxis><yAxis><NumberAxis label="Accuracy (%)"/></yAxis></BarChart><PieChart fx:id="accuracyChart" title="Accuracy distribution" prefHeight="300" HBox.hgrow="ALWAYS"/></HBox><HBox spacing="18"><LineChart fx:id="trendChart" prefHeight="300" HBox.hgrow="ALWAYS"><xAxis><CategoryAxis label="Attempt date"/></xAxis><yAxis><NumberAxis label="Percentage"/></yAxis></LineChart><BarChart fx:id="difficultyChart" prefHeight="300" HBox.hgrow="ALWAYS"><xAxis><CategoryAxis label="Difficulty"/></xAxis><yAxis><NumberAxis label="Accuracy (%)"/></yAxis></BarChart></HBox><Label fx:id="statusLabel" styleClass="status-text"/></VBox></ScrollPane></center></BorderPane>
