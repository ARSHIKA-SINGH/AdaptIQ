<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.StudentController" styleClass="dashboard-shell">
  <left>
    <VBox prefWidth="244" spacing="4" styleClass="sidebar">
      <HBox spacing="10" alignment="CENTER_LEFT" styleClass="sidebar-brand"><Label text="A" styleClass="logo-mark"/><VBox spacing="2"><Label text="AdaptIQ" styleClass="sidebar-title"/><Label text="LEARNING SPACE" styleClass="sidebar-caption"/></VBox></HBox>
      <Label text="LEARN" styleClass="sidebar-section"/>
      <Button text="Dashboard" maxWidth="1.7976931348623157E308" styleClass="sidebar-button-active"/>
      <Button text="Available examinations" onAction="#showAvailableExams" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/>
      <Label text="INSIGHTS" styleClass="sidebar-section"/>
      <Button text="Performance analytics" onAction="#showAnalytics" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/>
      <Button text="Recommended practice" onAction="#showRecommendations" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/>
      <Button text="Refresh dashboard" onAction="#refresh" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/>
      <Region VBox.vgrow="ALWAYS"/>
      <Button text="Sign out" onAction="#logout" maxWidth="1.7976931348623157E308" styleClass="signout-button"/>
    </VBox>
  </left>
  <center>
    <ScrollPane fitToWidth="true" styleClass="plain-scroll"><VBox spacing="20" styleClass="dashboard-content">
      <HBox alignment="CENTER_LEFT" styleClass="topbar">
        <VBox spacing="4"><Label text="LEARNING DASHBOARD" styleClass="page-kicker"/><Label text="Your progress, at a glance" styleClass="page-title"/><Label text="Use your latest assessment data to decide what to practise next." styleClass="section-caption"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="10" alignment="CENTER_RIGHT"><Button fx:id="refreshButton" text="Refresh" onAction="#refresh" styleClass="outline-button"/><HBox spacing="8" alignment="CENTER_LEFT" styleClass="profile-chip"><Label text="S" styleClass="avatar"/><Label fx:id="userNameLabel" styleClass="profile-name"/></HBox></HBox>
      </HBox>
      <HBox spacing="14">
        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="EXAMS ATTEMPTED" styleClass="metric-label"/><Label fx:id="attemptsLabel" text="--" styleClass="metric-value"/><Label text="Completed assessments" styleClass="metric-accent"/></VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="AVERAGE SCORE" styleClass="metric-label"/><Label fx:id="averageLabel" text="--" styleClass="metric-value"/><Label text="Across saved results" styleClass="metric-accent"/></VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="OVERALL ACCURACY" styleClass="metric-label"/><Label fx:id="accuracyLabel" text="--" styleClass="metric-value"/><Label text="Answered questions" styleClass="metric-accent"/></VBox>
        <VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="HIGHEST SCORE" styleClass="metric-label"/><Label fx:id="highScoreLabel" text="--" styleClass="metric-value"/><Label text="Best performance" styleClass="metric-accent"/></VBox>
      </HBox>
      <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox prefWidth="360" spacing="8" HBox.hgrow="ALWAYS" styleClass="content-card"><HBox alignment="CENTER_LEFT"><VBox spacing="2"><Label text="Recent examinations" styleClass="section-title"/><Label text="Latest submitted attempts" styleClass="section-caption"/></VBox></HBox><ListView fx:id="recentAttemptsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/></VBox>
        <VBox prefWidth="250" spacing="8" HBox.hgrow="ALWAYS" styleClass="content-card"><Label text="Topic strengths" styleClass="section-title"/><Label text="Strongest topics" styleClass="section-caption"/><ListView fx:id="strongTopicsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/><Label text="Focus areas" styleClass="section-title"/><Label text="Topics needing attention" styleClass="section-caption"/><ListView fx:id="weakTopicsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/></VBox>
        <VBox prefWidth="300" spacing="8" HBox.hgrow="ALWAYS" styleClass="content-card"><Label text="Recommended practice" styleClass="section-title"/><Label text="Generated from topic performance" styleClass="section-caption"/><ListView fx:id="recommendationsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/><Button text="View recommendations" onAction="#showRecommendations" styleClass="outline-button"/></VBox>
      </HBox>
      <Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/>
    </VBox></ScrollPane>
  </center>
</BorderPane>
