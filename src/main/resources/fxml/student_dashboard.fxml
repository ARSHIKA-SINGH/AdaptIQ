<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.StudentController" styleClass="dashboard-shell">
    <left><VBox prefWidth="220" spacing="12" styleClass="sidebar"><padding><Insets top="28" right="18" bottom="28" left="18"/></padding><Label text="AdaptIQ" styleClass="sidebar-title"/><Label text="STUDENT PORTAL" styleClass="sidebar-caption"/><Region VBox.vgrow="ALWAYS"/><Button text="Available examinations" onAction="#showAvailableExams" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Performance analytics" onAction="#showAnalytics" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Recommended practice" onAction="#showRecommendations" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Refresh dashboard" onAction="#refresh" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Sign out" onAction="#logout" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/></VBox></left>
    <center><VBox spacing="22" styleClass="dashboard-content"><padding><Insets top="28" right="34" bottom="28" left="34"/></padding>
        <HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Student dashboard" styleClass="page-title"/><Label text="Your recorded performance and learning priorities" styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox alignment="CENTER_RIGHT" spacing="4"><Label fx:id="userNameLabel" styleClass="profile-name"/><Button fx:id="refreshButton" text="Refresh" onAction="#refresh" styleClass="outline-button"/></VBox></HBox>
        <HBox spacing="14"><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="EXAMS ATTEMPTED" styleClass="metric-label"/><Label fx:id="attemptsLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="AVERAGE SCORE" styleClass="metric-label"/><Label fx:id="averageLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="OVERALL ACCURACY" styleClass="metric-label"/><Label fx:id="accuracyLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="HIGHEST SCORE" styleClass="metric-label"/><Label fx:id="highScoreLabel" text="—" styleClass="metric-value"/></VBox></HBox>
        <HBox spacing="16" VBox.vgrow="ALWAYS"><VBox prefWidth="390" spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS"><Label text="Recent examinations" styleClass="section-title"/><ListView fx:id="recentAttemptsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/></VBox><VBox prefWidth="260" spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS"><Label text="Weakest topics" styleClass="section-title"/><ListView fx:id="weakTopicsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/><Label text="Strongest topics" styleClass="section-title"/><ListView fx:id="strongTopicsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/></VBox><VBox prefWidth="300" spacing="8" styleClass="content-card" HBox.hgrow="ALWAYS"><Label text="Recommended practice" styleClass="section-title"/><ListView fx:id="recommendationsList" VBox.vgrow="ALWAYS" styleClass="clean-list"/></VBox></HBox>
        <Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/>
    </VBox></center>
</BorderPane>
