<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.AvailableExamsController" styleClass="dashboard-shell"><top><HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar"><padding><Insets top="16" right="26" bottom="16" left="26"/></padding><Button text="← Dashboard" onAction="#back" styleClass="outline-button"/><Label text="Available normal examinations" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refresh" styleClass="outline-button"/></HBox></top><center><VBox spacing="12" styleClass="dashboard-content"><padding><Insets top="24" right="26" bottom="24" left="26"/></padding><Label text="Select an examination to start. The timer begins when you confirm." styleClass="muted-text"/><ListView fx:id="examList" VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button text="Start selected examination" onAction="#start" styleClass="primary-button"/></HBox><Label fx:id="statusLabel" styleClass="status-text"/></VBox></center></BorderPane>
