<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.QuestionBankController" styleClass="dashboard-shell">
 <top><HBox spacing="12" alignment="CENTER_LEFT" styleClass="toolbar"><padding><Insets top="16" right="26" bottom="16" left="26"/></padding><Button text="← Dashboard" onAction="#returnToDashboard" styleClass="outline-button"/><Label text="Question bank" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#search" styleClass="outline-button"/></HBox></top>
 <center><SplitPane dividerPositions="0.53"><items><VBox spacing="12" styleClass="dashboard-content"><padding><Insets top="18" right="16" bottom="24" left="26"/></padding><HBox spacing="8"><ChoiceBox fx:id="subjectChoice" onAction="#loadTopicsForSubject" prefWidth="145"/><ChoiceBox fx:id="topicChoice" prefWidth="145"/><ChoiceBox fx:id="difficultyChoice" prefWidth="110"/><TextField fx:id="searchField" promptText="Search questions" HBox.hgrow="ALWAYS"/><Button text="Search" onAction="#search" styleClass="primary-button"/></HBox><TableView fx:id="questionTable" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="questionColumn" text="Question" prefWidth="250"/><TableColumn fx:id="topicColumn" text="Topic" prefWidth="120"/><TableColumn fx:id="difficultyColumn" text="Level" prefWidth="80"/><TableColumn fx:id="marksColumn" text="Marks" prefWidth="65"/></columns></TableView></VBox><ScrollPane fitToWidth="true" styleClass="plain-scroll"><VBox spacing="9" styleClass="editor-panel"><padding><Insets top="18" right="26" bottom="24" left="18"/></padding><Label text="Question editor" styleClass="section-title"/><Label text="Question"/><TextArea fx:id="questionTextArea" prefRowCount="3" wrapText="true"/><HBox spacing="8"><VBox HBox.hgrow="ALWAYS"><Label text="Topic"/><ChoiceBox fx:id="questionTopicChoice" maxWidth="1.7976931348623157E308"/></VBox><VBox HBox.hgrow="ALWAYS"><Label text="Difficulty"/><ChoiceBox fx:id="questionDifficultyChoice" maxWidth="1.7976931348623157E308"/></VBox></HBox><Label text="Marks"/><TextField fx:id="marksField" promptText="e.g. 2"/><Label text="Option A"/><TextField fx:id="optionAField"/><Label text="Option B"/><TextField fx:id="optionBField"/><Label text="Option C"/><TextField fx:id="optionCField"/><Label text="Option D"/><TextField fx:id="optionDField"/><Label text="Correct option"/><ChoiceBox fx:id="correctOptionChoice"/><Label text="Explanation (shown after submission)"/><TextArea fx:id="explanationTextArea" prefRowCount="3" wrapText="true"/><HBox spacing="8"><Button text="Save question" onAction="#saveQuestion" styleClass="primary-button"/><Button text="Clear" onAction="#clearForm" styleClass="outline-button"/><Button text="Delete" onAction="#deleteQuestion" styleClass="danger-button"/></HBox><Label fx:id="statusLabel" wrapText="true" styleClass="status-text"/></VBox></ScrollPane></items></SplitPane></center>
</BorderPane>
