<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.ExamController" styleClass="exam-shell"><fx:define><ToggleGroup fx:id="answerGroup"/></fx:define><top><HBox alignment="CENTER_LEFT" styleClass="exam-header"><padding><Insets top="18" right="32" bottom="18" left="32"/></padding><Label fx:id="titleLabel" styleClass="exam-title"/><Region HBox.hgrow="ALWAYS"/><Label text="Time remaining: " styleClass="exam-time-label"/><Label fx:id="timerLabel" text="--:--" styleClass="exam-timer"/></HBox></top><center><VBox maxWidth="850" spacing="20" styleClass="exam-card"><padding><Insets top="36" right="42" bottom="36" left="42"/></padding><Label fx:id="questionNumberLabel" styleClass="metric-label"/><Label fx:id="questionLabel" wrapText="true" styleClass="exam-question"/><RadioButton fx:id="optionA" toggleGroup="$answerGroup" wrapText="true" styleClass="answer-option"/><RadioButton fx:id="optionB" toggleGroup="$answerGroup" wrapText="true" styleClass="answer-option"/><RadioButton fx:id="optionC" toggleGroup="$answerGroup" wrapText="true" styleClass="answer-option"/><RadioButton fx:id="optionD" toggleGroup="$answerGroup" wrapText="true" styleClass="answer-option"/><HBox spacing="12"><Button fx:id="previousButton" text="Previous" onAction="#previous" styleClass="outline-button"/><Button fx:id="nextButton" text="Next" onAction="#next" styleClass="outline-button"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="submitButton" text="Submit examination" onAction="#submit" styleClass="danger-button"/></HBox><Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/></VBox></center></BorderPane>
