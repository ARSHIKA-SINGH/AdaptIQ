<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.CatalogController" styleClass="dashboard-shell">
 <top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar"><padding><Insets top="16" right="26" bottom="16" left="26"/></padding><Button text="← Dashboard" onAction="#returnToDashboard" styleClass="outline-button"/><Label text="Subject &amp; topic catalogue" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh" onAction="#refreshSubjects" styleClass="outline-button"/></HBox></top>
 <center><HBox spacing="18" styleClass="dashboard-content"><padding><Insets top="24" right="26" bottom="24" left="26"/></padding><VBox prefWidth="300" spacing="10" styleClass="content-card" HBox.hgrow="ALWAYS"><Label text="Subjects" styleClass="section-title"/><ListView fx:id="subjectList" VBox.vgrow="ALWAYS"/><Label text="Name"/><TextField fx:id="subjectNameField"/><Label text="Description"/><TextArea fx:id="subjectDescriptionArea" prefRowCount="3"/><HBox spacing="8"><Button text="Save" onAction="#saveSubject" styleClass="primary-button"/><Button text="Clear" onAction="#clearSubject" styleClass="outline-button"/><Button text="Delete" onAction="#deleteSubject" styleClass="danger-button"/></HBox></VBox><VBox prefWidth="300" spacing="10" styleClass="content-card" HBox.hgrow="ALWAYS"><Label text="Topics" styleClass="section-title"/><Label text="Select a subject before adding a topic" styleClass="muted-text" wrapText="true"/><ListView fx:id="topicList" VBox.vgrow="ALWAYS"/><Label text="Name"/><TextField fx:id="topicNameField"/><Label text="Description"/><TextArea fx:id="topicDescriptionArea" prefRowCount="3"/><HBox spacing="8"><Button text="Save" onAction="#saveTopic" styleClass="primary-button"/><Button text="Clear" onAction="#clearTopic" styleClass="outline-button"/><Button text="Delete" onAction="#deleteTopic" styleClass="danger-button"/></HBox></VBox></HBox></center>
 <bottom><Label fx:id="statusLabel" styleClass="status-text" wrapText="true"><BorderPane.margin><Insets top="0" right="26" bottom="16" left="26"/></BorderPane.margin></Label></bottom>
</BorderPane>
