<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.FacultyController" styleClass="dashboard-shell">
    <left><VBox prefWidth="220" spacing="12" styleClass="sidebar"><padding><Insets top="28" right="18" bottom="28" left="18"/></padding><Label text="AdaptIQ" styleClass="sidebar-title"/><Label text="FACULTY PORTAL" styleClass="sidebar-caption"/><Region VBox.vgrow="ALWAYS"/><Button text="Question bank" onAction="#showQuestionBank" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Create examination" onAction="#showExamBuilder" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Refresh dashboard" onAction="#refresh" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Sign out" onAction="#logout" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/></VBox></left>
    <center><VBox spacing="22" styleClass="dashboard-content"><padding><Insets top="28" right="34" bottom="28" left="34"/></padding><HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Faculty dashboard" styleClass="page-title"/><Label text="A live overview of examinations you manage" styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox alignment="CENTER_RIGHT" spacing="4"><Label fx:id="userNameLabel" styleClass="profile-name"/><Button fx:id="refreshButton" text="Refresh" onAction="#refresh" styleClass="outline-button"/></VBox></HBox><HBox spacing="16"><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="TOTAL EXAMS" styleClass="metric-label"/><Label fx:id="examsLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="PUBLISHED" styleClass="metric-label"/><Label fx:id="publishedLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="STUDENT ATTEMPTS" styleClass="metric-label"/><Label fx:id="attemptsLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="AVERAGE RESULT" styleClass="metric-label"/><Label fx:id="averageLabel" text="—" styleClass="metric-value"/></VBox></HBox><VBox styleClass="content-card" spacing="10"><Label text="Phase 4 will add question-bank and examination creation controls." styleClass="section-title"/><Label text="These statistics already reflect actual examinations and submitted attempts in MySQL." styleClass="muted-text"/></VBox><Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/></VBox></center>
</BorderPane>
