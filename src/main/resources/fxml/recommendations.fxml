<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.RecommendationsController" styleClass="dashboard-shell"><top><HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar"><padding><Insets top="16" right="26" bottom="16" left="26"/></padding><Button text="← Dashboard" onAction="#back" styleClass="outline-button"/><Label text="Recommended practice" styleClass="page-title"/><Region HBox.hgrow="ALWAYS"/><Button text="Refresh recommendations" onAction="#refresh" styleClass="outline-button"/></HBox></top><center><VBox spacing="14" styleClass="dashboard-content"><padding><Insets top="24" right="26" bottom="24" left="26"/></padding><Label text="Recommendations use your latest topic-wise examination performance." styleClass="muted-text"/><ListView fx:id="recommendationList" VBox.vgrow="ALWAYS"/><Button text="Mark selected as completed" onAction="#complete" styleClass="primary-button"/><Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/></VBox></center></BorderPane>
