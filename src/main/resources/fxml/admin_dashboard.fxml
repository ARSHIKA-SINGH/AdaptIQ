<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.adaptiq.controller.AdminController" styleClass="dashboard-shell">
    <left><VBox prefWidth="220" spacing="12" styleClass="sidebar"><padding><Insets top="28" right="18" bottom="28" left="18"/></padding><Label text="AdaptIQ" styleClass="sidebar-title"/><Label text="ADMINISTRATION" styleClass="sidebar-caption"/><Region VBox.vgrow="ALWAYS"/><Button text="Manage catalogue" onAction="#showCatalog" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Refresh dashboard" onAction="#refresh" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/><Button text="Sign out" onAction="#logout" maxWidth="1.7976931348623157E308" styleClass="sidebar-button"/></VBox></left>
    <center><VBox spacing="22" styleClass="dashboard-content"><padding><Insets top="28" right="34" bottom="28" left="34"/></padding><HBox alignment="CENTER_LEFT"><VBox spacing="4"><Label text="Administration dashboard" styleClass="page-title"/><Label text="A live overview of platform records" styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><VBox alignment="CENTER_RIGHT" spacing="4"><Label fx:id="userNameLabel" styleClass="profile-name"/><Button fx:id="refreshButton" text="Refresh" onAction="#refresh" styleClass="outline-button"/></VBox></HBox><HBox spacing="16"><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="STUDENTS" styleClass="metric-label"/><Label fx:id="studentsLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="FACULTY" styleClass="metric-label"/><Label fx:id="facultyLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="EXAMINATIONS" styleClass="metric-label"/><Label fx:id="examsLabel" text="—" styleClass="metric-value"/></VBox><VBox HBox.hgrow="ALWAYS" styleClass="metric-card"><Label text="QUESTIONS" styleClass="metric-label"/><Label fx:id="questionsLabel" text="—" styleClass="metric-value"/></VBox></HBox><VBox styleClass="content-card" spacing="10"><Label text="Phase 4 will add subject, topic, and account-management operations." styleClass="section-title"/><Label text="These counts are retrieved from the MySQL database and are not sample values." styleClass="muted-text"/></VBox><Label fx:id="statusLabel" styleClass="status-text" wrapText="true"/></VBox></center>
</BorderPane>
